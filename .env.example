# PostgreSQL connection string used by Prisma (CLI and runtime).
# With the bundled docker-compose.yml:
DATABASE_URL="postgresql://capitalia:capitalia@localhost:5433/capitalia?schema=public"

# Secret used by Auth.js to sign session cookies. Generate one with:
#   npx auth secret        (or)        openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Credentials of the administrator created by `npm run db:seed`.
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@capitalia.local"
SEED_ADMIN_PASSWORD="Admin123*"

# Secret shared with the automation that forwards bank emails/SMS to POST /api/inbox.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INBOX_TOKEN="replace-me-with-at-least-32-random-characters"

# Correo saliente (recordatorios de pago). Cuenta de solo envío.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="noresponderfinanzas@gmail.com"
# Contraseña de aplicación de esa cuenta de Gmail (16 caracteres, exige verificación en dos pasos).
SMTP_PASSWORD=""
SMTP_FROM_NAME="Capitalia"

# Secreto que Vercel Cron envía al llamar /api/recordatorios.
CRON_SECRET=""

# Local: escribe los correos en el log en vez de enviarlos de verdad.
# Se ignora en producción; en Vercel no la definas.
MAILER_DRY_RUN="true"
