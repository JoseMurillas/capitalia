# PostgreSQL connection string used by Prisma (CLI and runtime).
# With the bundled docker-compose.yml:
DATABASE_URL="postgresql://capitalia:capitalia@localhost:5433/capitalia?schema=public"

# Secret used by Auth.js to sign session cookies. Generate one with:
#   npx auth secret        (or)        openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Credentials of the administrator created by `npm run db:seed`.
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@capitalia.local"
SEED_ADMIN_PASSWORD="Admin123*"
