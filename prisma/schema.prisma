generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum LoanStatus {
  ACTIVE
  PAID
  OVERDUE
  CANCELLED
}

enum InterestType {
  SIMPLE
}

enum InstallmentFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
  CUSTOM
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

/// How the administrator asked a payment to be applied.
enum PaymentKind {
  AUTO
  INTEREST_ONLY
  PRINCIPAL
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  SALARY
  LOAN_INTEREST
  OTHER_INCOME
  FOOD
  TRANSPORT
  HOUSING
  SERVICES
  ENTERTAINMENT
  OTHER_EXPENSE
  SUBSCRIPTIONS
  INSURANCE
  HEALTH
  EDUCATION
  DEBT
  CREDIT_CARD_PAYMENT
}

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM
}

enum RecurringPaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  OTHER
}

enum CreditCardMovementKind {
  CHARGE
  PAYMENT
  ADJUSTMENT
}

enum CashBoxMovementKind {
  OPENING
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  LOAN_DISBURSEMENT
  LOAN_PAYMENT
  LOAN_REVERSAL
  LOAN_REASSIGNMENT
  ADJUSTMENT
}

/// Where the money comes from or goes to on a deposit or a withdrawal.
enum CashBoxCounterparty {
  PERSONAL_FINANCES
  EXTERNAL
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid(2))
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

/// Someone who borrows money from the administrator.
model Person {
  id        String   @id @default(cuid(2))
  name      String
  phone     String?
  email     String?
  document  String?  @unique
  address   String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loans Loan[]

  @@index([name])
  @@map("people")
}

model Loan {
  id                   String               @id @default(cuid(2))
  personId             String
  person               Person               @relation(fields: [personId], references: [id], onDelete: Restrict)
  /// Fund the money was lent from. Optional in the database so historical loans
  /// survive the migration; required by the form.
  cashBoxId            String?
  cashBox              CashBox?             @relation(fields: [cashBoxId], references: [id], onDelete: Restrict)
  principalAmount      Decimal              @db.Decimal(15, 2)
  /// Monthly rate as a percentage, e.g. 12.000 means 12 % per month.
  monthlyInterestRate  Decimal              @db.Decimal(6, 3)
  interestType         InterestType         @default(SIMPLE)
  numberOfInstallments Int
  installmentFrequency InstallmentFrequency
  /// Days between installments; only used when installmentFrequency is CUSTOM.
  customIntervalDays   Int?
  startDate            DateTime             @db.Date
  dueDate              DateTime             @db.Date
  status               LoanStatus           @default(ACTIVE)
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  installments Installment[]
  payments     Payment[]
  cashBoxMovements CashBoxMovement[]

  @@index([personId])
  @@index([cashBoxId])
  @@index([status])
  @@index([dueDate])
  @@map("loans")
}

model Installment {
  id                String            @id @default(cuid(2))
  loanId            String
  loan              Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
  installmentNumber Int
  dueDate           DateTime          @db.Date
  principalAmount   Decimal           @db.Decimal(15, 2)
  interestAmount    Decimal           @db.Decimal(15, 2)
  totalAmount       Decimal           @db.Decimal(15, 2)
  principalPaid     Decimal           @default(0) @db.Decimal(15, 2)
  interestPaid      Decimal           @default(0) @db.Decimal(15, 2)
  paidAmount        Decimal           @default(0) @db.Decimal(15, 2)
  status            InstallmentStatus @default(PENDING)
  paidAt            DateTime?         @db.Date

  payments    Payment[]
  allocations PaymentAllocation[]

  @@unique([loanId, installmentNumber])
  @@index([dueDate, status])
  @@map("installments")
}

model Payment {
  id            String        @id @default(cuid(2))
  loanId        String
  loan          Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  /// Installment the user chose when registering the payment; the exact split
  /// across installments lives in PaymentAllocation.
  installmentId String?
  installment   Installment?  @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  amount        Decimal       @db.Decimal(15, 2)
  principalPaid Decimal       @db.Decimal(15, 2)
  interestPaid  Decimal       @db.Decimal(15, 2)
  paymentDate   DateTime      @db.Date
  paymentMethod PaymentMethod
  kind          PaymentKind   @default(AUTO)
  notes         String?
  createdAt     DateTime      @default(now())

  allocations PaymentAllocation[]
  cashBoxMovements CashBoxMovement[]

  @@index([loanId])
  @@index([paymentDate])
  @@map("payments")
}

/// How much of a payment went to each installment (a payment may cover several).
model PaymentAllocation {
  id            String      @id @default(cuid(2))
  paymentId     String
  payment       Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  installmentId String
  installment   Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  principalPaid Decimal     @db.Decimal(15, 2)
  interestPaid  Decimal     @db.Decimal(15, 2)

  @@index([paymentId])
  @@index([installmentId])
  @@map("payment_allocations")
}

/// Personal income and expenses, independent from loan cash flows.
model Transaction {
  id              String              @id @default(cuid(2))
  type            TransactionType
  category        TransactionCategory
  amount          Decimal             @db.Decimal(15, 2)
  description     String
  transactionDate DateTime            @db.Date
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  /// Set when the movement was created by "marcar pagado" on a recurring expense.
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  inboxMessage InboxMessage?
  cardMovement CreditCardMovement?

  @@index([transactionDate])
  @@index([type, category])
  @@index([recurringExpenseId])
  @@map("transactions")
}

// ---------------------------------------------------------------------------
// Inbox: bank notifications (email/SMS) waiting to be confirmed as transactions
// ---------------------------------------------------------------------------

enum InboxSource {
  EMAIL
  SMS
}

enum InboxStatus {
  PENDING
  CONFIRMED
  DISCARDED
}

enum InboxDirection {
  INCOME
  EXPENSE
  UNKNOWN
}

model InboxMessage {
  id            String         @id @default(cuid(2))
  source        InboxSource
  /// Id in the source system (Gmail message id); makes re-deliveries idempotent.
  externalId    String
  receivedAt    DateTime
  sender        String?
  subject       String?
  body          String
  status        InboxStatus    @default(PENDING)
  /// Fields extracted by the parser; the user can correct them before confirming.
  amount        Decimal?       @db.Decimal(15, 2)
  direction     InboxDirection @default(UNKNOWN)
  description   String?
  suggestedDate DateTime?      @db.Date
  transactionId String?        @unique
  transaction   Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([source, externalId])
  @@index([status, receivedAt])
  @@map("inbox_messages")
}

/// Small key/value store for settings edited from the app (e.g. the inbox token hash).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ---------------------------------------------------------------------------
// Financial commitments: recurring expenses and credit cards
// ---------------------------------------------------------------------------

/// A payment the user makes periodically (rent, subscriptions, insurance, debts…).
/// Only the *next* due date is stored; "marcar pagado" records the expense and advances it.
model RecurringExpense {
  id                 String                 @id @default(cuid(2))
  name               String
  /// Expense categories only (validated in zod).
  category           TransactionCategory
  amount             Decimal                @db.Decimal(15, 2)
  /// True when the real amount changes each period (utilities); `amount` is then an estimate.
  isVariable         Boolean                @default(false)
  frequency          RecurringFrequency
  /// Days between payments; only used when frequency is CUSTOM.
  customIntervalDays Int?
  nextDueDate        DateTime               @db.Date
  paymentMethod      RecurringPaymentMethod
  /// Required when paymentMethod is CREDIT_CARD: paying adds to that card's balance instead of cash.
  creditCardId       String?
  creditCard         CreditCard?            @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  /// Alert window: days before nextDueDate the app starts warning.
  reminderDays       Int                    @default(3)
  lastPaidDate       DateTime?              @db.Date
  active             Boolean                @default(true)
  notes              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  transactions  Transaction[]
  cardMovements CreditCardMovement[]

  @@index([active, nextDueDate])
  @@index([creditCardId])
  @@map("recurring_expenses")
}

/// A credit card tracked as an obligation. Its limit is never money the user has.
model CreditCard {
  id              String    @id @default(cuid(2))
  name            String
  creditLimit     Decimal   @db.Decimal(15, 2)
  /// Outstanding balance (cupo utilizado). Updated by charges, payments and statement adjustments.
  balance         Decimal   @default(0) @db.Decimal(15, 2)
  minimumPayment  Decimal?  @db.Decimal(15, 2)
  /// What the user plans to pay this cycle; null means "the minimum".
  paymentAmount   Decimal?  @db.Decimal(15, 2)
  nextClosingDate DateTime  @db.Date
  nextPaymentDate DateTime  @db.Date
  reminderDays    Int       @default(3)
  active          Boolean   @default(true)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  recurringExpenses RecurringExpense[]
  installmentPlans  CreditCardInstallmentPlan[]
  movements         CreditCardMovement[]

  @@index([active, nextPaymentDate])
  @@map("credit_cards")
}

/// A purchase deferred into N installments (compra diferida). Informative: it explains
/// the monthly payment but does not change the balance by itself.
model CreditCardInstallmentPlan {
  id                String     @id @default(cuid(2))
  creditCardId      String
  creditCard        CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  description       String
  totalAmount       Decimal    @db.Decimal(15, 2)
  /// Typed by the user: banks add interest, so it is not totalAmount / installments.
  installmentAmount Decimal    @db.Decimal(15, 2)
  installments      Int
  paidInstallments  Int        @default(0)
  startDate         DateTime   @db.Date
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([creditCardId])
  @@map("credit_card_installment_plans")
}

/// History of a card's balance: charges (+), payments (−) and statement adjustments (±).
model CreditCardMovement {
  id                 String                 @id @default(cuid(2))
  creditCardId       String
  creditCard         CreditCard             @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  kind               CreditCardMovementKind
  /// Positive for CHARGE and PAYMENT; ADJUSTMENT may be negative.
  amount             Decimal                @db.Decimal(15, 2)
  movementDate       DateTime               @db.Date
  description        String
  recurringExpenseId String?
  recurringExpense   RecurringExpense?      @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  /// The expense created in Finanzas when the movement is a PAYMENT.
  transactionId      String?                @unique
  transaction        Transaction?           @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt          DateTime               @default(now())

  @@index([creditCardId, movementDate])
  @@map("credit_card_movements")
}

// ---------------------------------------------------------------------------
// Cash boxes: named funds the lending capital lives in
// ---------------------------------------------------------------------------

/// A fund the administrator lends from. Its balance is never stored: it is the
/// sum of its movements, so no balance can change without a traceable row.
model CashBox {
  id          String   @id @default(cuid(2))
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movements CashBoxMovement[]
  loans     Loan[]

  @@index([active, name])
  @@map("cash_boxes")
}

/// One line of a cash box's ledger. `amount` is signed: positive enters the
/// box, negative leaves it, so the balance is a single sum.
model CashBoxMovement {
  id               String               @id @default(cuid(2))
  cashBoxId        String
  cashBox          CashBox              @relation(fields: [cashBoxId], references: [id], onDelete: Cascade)
  kind             CashBoxMovementKind
  amount           Decimal              @db.Decimal(15, 2)
  movementDate     DateTime             @db.Date
  description      String
  notes            String?
  /// Only on DEPOSIT and WITHDRAWAL: personal finances or outside the system.
  counterparty     CashBoxCounterparty?
  /// The other box on a transfer or a loan reassignment.
  relatedCashBoxId String?
  /// Ties the two sides of a transfer or reassignment together.
  transferGroupId  String?
  loanId           String?
  loan             Loan?                @relation(fields: [loanId], references: [id], onDelete: SetNull)
  paymentId        String?
  payment          Payment?             @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())

  @@index([cashBoxId, movementDate])
  @@index([loanId])
  @@index([transferGroupId])
  @@map("cash_box_movements")
}
